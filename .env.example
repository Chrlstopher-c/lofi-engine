# Racine servie par le serveur statique (défaut : ./dist)
LOFI_ROOT=./dist

# Port d'écoute local (défaut : 4707)
LOFI_PORT=4707

# Interface d'écoute (défaut : 127.0.0.1 — ne pas exposer sans reverse proxy)
# En conteneur, le serveur écoute déjà sur 0.0.0.0 (voir Dockerfile)
LOFI_HOST=127.0.0.1

# Déploiement Pi — hôte SSH et chemin cible
PI_HOST=pi-trinity
PI_PATH=/mnt/projects/lofi-engine

# --- Diffusion en continu (voir docs/STREAM-24-7.md) ---
# Trois modes, au choix, chacun sous son profil docker compose :
#   --profile generateur  enregistre un corpus (ponctuel, temps réel)
#   --profile direct      le moteur génère en continu, repli sur le corpus si le
#                         navigateur tombe  ← mode retenu
#   --profile diffusion   lit seulement le corpus en boucle, sans navigateur
# Activer l'une, l'autre, ou les deux
STREAM_TWITCH=false
STREAM_YOUTUBE=false

# Clés de diffusion — ne JAMAIS les écrire ici, seulement dans .env (ignoré par git)
TWITCH_STREAM_KEY=
YOUTUBE_STREAM_KEY=

# Serveurs d'ingestion (à changer seulement si besoin)
TWITCH_INGEST=rtmp://live.twitch.tv/app
YOUTUBE_INGEST=rtmp://a.rtmp.youtube.com/live2

# --- Scène affichée à l'écran (profil « direct ») ---
# La scène se définit dans le centre de contrôle (http://localhost:4708), qui écrit
# corpus/scene.json : image de fond, calques, textes, thème. Ne pas la configurer ici,
# deux sources de vérité finiraient par se contredire.
# STREAM_SCENE=false revient à une simple image fixe (celle de STREAM_IMAGE).
STREAM_SCENE=true

# Rendu du flux
STREAM_IMAGE=fond.png
STREAM_RESOLUTION=1920x1080
# 30 ou 60, jamais 25 ni 50. Les cadences PAL passent l'ingestion sans erreur, puis YouTube
# construit une échelle de qualités entièrement CARRÉE : mesuré le 2026-09-10, sept rendus de
# 1440x1440 à 144x144 sans un seul 16:9, et la scène servie encadrée de noir. En 30 i/s, sur la
# même diffusion et la même clé, tous les rendus repassent en 16:9. Twitch, lui, n'y voit rien.
STREAM_FPS=30
STREAM_VIDEO_BITRATE=1500k
STREAM_AUDIO_BITRATE=160k

# Encodeur vidéo. « auto » essaie la puce vidéo de la carte graphique, puis celle du
# processeur, et retombe sur le logiciel — chaque profil est réellement testé avant d'être
# retenu. Encoder en logiciel coûte environ un cœur en 1080p, presque rien sur une puce
# vidéo : sur une petite machine, c'est la différence entre un flux stable et un flux qui
# décroche. L'accès au matériel est donné automatiquement par stream/materiel.sh.
# Valeurs : auto | nvenc (NVIDIA) | vaapi (Intel/AMD) | x264 (logiciel)
STREAM_ENCODEUR=auto

# Qualité constante VAAPI, utilisée seulement quand la puce n'accepte aucun plafond de débit —
# le cas des petites puces Intel, qui n'encodent que par la voie « basse consommation ». Plus le
# nombre est haut, plus l'image est compressée et le flux léger. Mesuré : en qp 24, un NUC
# sortait à 12 Mbit/s PAR destination, sept fois la cible, ce qui saturait la liaison montante
# et faisait décrocher les deux plateformes. Chaque palier de six divise le poids par deux.
# Se vérifie en marche avec « docker stats lofi-direct », colonne NET I/O.
STREAM_VAAPI_QP=30

# Qui dessine la scène. « auto » la fait composer par ffmpeg, ce qui divise la charge par
# deux — mesuré 306 % de processeur avant, 105 % après, et en 30 images par seconde au lieu
# de 25. Le navigateur reste, réduit à ce que lui seul sait faire : produire la musique.
# Un calque que ffmpeg ne sait pas rendre — les accords, qui viennent du moteur musical —
# fait repasser « auto » par le navigateur, pour ne rien perdre de la scène.
# Valeurs : auto | ffmpeg (composer même s'il manque un calque) | navigateur (comme avant)
STREAM_COMPOSITEUR=auto

# Génération du corpus (profil « generateur »)
# CAPTURE_DUREE : durée totale d'une session de capture, en secondes.
#   La capture se fait en temps réel : une heure de musique coûte une heure.
#   3600 = 1 h · 21600 = 6 h · 43200 = 12 h
CAPTURE_DUREE=3600
# Taille d'un segment du corpus, en secondes (600 = 10 min)
SEGMENT_DUREE=600

# --- Pixabay (facultatif) ---
# Clé d'API pour chercher des fonds — images et vidéos — depuis le centre de contrôle,
# onglet Pixabay. Gratuite : créer un compte sur https://pixabay.com, puis la relever sur
# https://pixabay.com/api/docs/ une fois connecté. Elle se saisit dans l'interface, qui
# l'écrit ici même — ne pas l'écrire dans ce fichier d'exemple, qui est versionné.
PIXABAY_API_KEY=

# --- Twitch (facultatif) ---
# Identifiant de l'application Twitch. Ce n'est PAS un secret : Twitch le transmet en clair
# à chaque requête. Il est livré avec le projet pour que tu n'aies rien à créer — connecte
# simplement ton compte depuis le centre de contrôle, onglet Twitch.
# Pour utiliser ta propre application : la créer sur https://dev.twitch.tv/console/apps/create
# en type « Public », et remplacer la valeur ci-dessous (ou la saisir dans l'interface).
TWITCH_CLIENT_ID=bk7mz3tptf3kg2ev1bmoo6txrv6ctj
