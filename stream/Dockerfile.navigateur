# Image partagée par la génération de corpus et la diffusion en direct : les deux ont besoin
# d'un navigateur qui joue le moteur. Une seule image plutôt que deux fois 1,4 Go.
FROM debian:bookworm-slim

# chromium n'émet pas d'audio sans affichage : d'où xvfb. pulseaudio fournit le puits
# audio virtuel que ffmpeg vient lire. Rien n'est installé sur la machine hôte.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium xvfb pulseaudio pulseaudio-utils ffmpeg procps ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 capteur

COPY base.sh commun.sh navigateur.sh /usr/local/lib/lofi/
COPY generateur/capturer.sh direct/direct.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/capturer.sh /usr/local/bin/direct.sh

USER capteur
ENV HOME=/home/capteur \
    CORPUS_DIR=/corpus \
    LOFI_BASE=http://lofi-engine:4707

WORKDIR /corpus
CMD ["/usr/local/bin/capturer.sh"]
