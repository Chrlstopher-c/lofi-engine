# Image partagée par la génération de corpus et la diffusion en direct : les deux ont besoin
# d'un navigateur qui joue le moteur. Une seule image plutôt que deux fois 1,4 Go.
#
# Debian 13 et pas 12, pour une seule raison, mesurée : le muxer `tee` de ffmpeg 5.1 — celui de
# Debian 12 — produit un flux FLV que Twitch REFUSE. Il se connecte, envoie exactement le même
# volume d'octets qu'une sortie simple, ne signale aucune erreur, et la chaîne ne passe jamais
# en direct. Une sortie simple vers Twitch passe ; la même par `tee` ne passe pas.
#
# Isolé le 2026-09-10 en rejouant la poussée dans le réseau du conteneur avec ffmpeg 7.1 et
# rien d'autre de changé : la chaîne passe en direct. C'est donc bien la version, et elle
# n'était visible que lorsque les deux plateformes étaient actives — le muxer `tee` ne sert
# qu'à ce moment-là.
FROM debian:trixie-slim

# chromium n'émet pas d'audio sans affichage : d'où xvfb. pulseaudio fournit le puits
# audio virtuel que ffmpeg vient lire. Rien n'est installé sur la machine hôte.
# python3 sert au compositeur : il traduit la scène en chaîne de filtres ffmpeg, ce qui évite
# d'afficher cette scène dans un navigateur pour la recapturer ensuite.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium xvfb pulseaudio pulseaudio-utils ffmpeg procps ca-certificates python3 \
  && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 capteur

# Source Serif 4 (SIL OFL 1.1), la police de la scène, pour que ffmpeg écrive les mêmes
# lettres que l'aperçu du centre de contrôle.
COPY polices/ /usr/local/share/lofi-polices/

COPY base.sh commun.sh navigateur.sh /usr/local/lib/lofi/
COPY generateur/capturer.sh direct/direct.sh direct/tamis.sh direct/composition.sh direct/composer.py direct/relais-accords.py \
     /usr/local/bin/
RUN chmod +x /usr/local/bin/capturer.sh /usr/local/bin/direct.sh /usr/local/bin/tamis.sh /usr/local/bin/composer.py

USER capteur
ENV HOME=/home/capteur \
    CORPUS_DIR=/corpus \
    LOFI_BASE=http://lofi-engine:4707

WORKDIR /corpus
CMD ["/usr/local/bin/capturer.sh"]
